# ─────────────────────────────────────────────
# DEVLORE — Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
# Full URL of your deployment (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random secret for cron job authorization
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Database ─────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:5432/devlore

# ── Authentication (Auth.js v5) ───────────────
# Generate: openssl rand -hex 32
AUTH_SECRET=

# GitHub OAuth App credentials
# Create at: https://github.com/settings/applications/new
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── GitHub App (optional — enables private repo access) ──
# Register at: https://github.com/settings/apps/new
GITHUB_APP_ID=
# Paste the full PEM key, replace newlines with \n
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── AI (Gemini) ───────────────────────────────
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=

# ── Stripe ───────────────────────────────────
# Dashboard: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Price IDs from your Stripe Products
# Create 2 products: "DevLore Pro" ($9/mo) and "DevLore Legend" ($19/mo)
STRIPE_PRO_PRICE_ID=price_
STRIPE_LEGEND_PRICE_ID=price_

# ── Email (optional — Chronicle emails) ──────
# Get key at: https://resend.com/
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=chronicles@devlore.app

# ── Inngest (background jobs) ─────────────────
# Sign up at: https://inngest.com/
# In dev mode these are auto-generated; set for production
INNGEST_SIGNING_KEY=signkey-prod-
INNGEST_EVENT_KEY=
