# ─────────────────────────────────────────────
# DEVLORE — Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
# Full URL of your deployment (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random secret for cron job authorization
# Generate: openssl rand -hex 32
CRON_SECRET=

# ── Database ─────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:5432/devlore

# ── Authentication (Auth.js v5) ───────────────
# Generate: openssl rand -hex 32
AUTH_SECRET=

# GitHub OAuth App credentials
# Create at: https://github.com/settings/applications/new
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── GitHub App (optional — enables private repo access) ──
# Register at: https://github.com/settings/apps/new
GITHUB_APP_ID=
# Paste the full PEM key, replace newlines with \n
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── AI providers (free tiers, with automatic failover) ────────────────────────
# DevLore tries each configured provider in order and moves to the next one on
# a rate limit, quota error, or outage. Configure as many as you like — more
# keys means more free headroom. With NONE set, the site still works: narrative
# text comes from the built-in deterministic writer instead of a model.
#
# Check what's live at: GET /api/ai/status?probe=1  (must be signed in)

# Google AI Studio — https://aistudio.google.com  (keys start with "AIza")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq — https://console.groq.com  (free, no credit card, very fast)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras — https://cloud.cerebras.ai  (free daily token allowance)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Mistral — https://console.mistral.ai  (free "Experiment" tier)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter — https://openrouter.ai/keys  (aggregates many free models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional: override the failover order (unlisted providers still run, last).
# AI_PROVIDER_ORDER=groq,gemini,cerebras,mistral,openrouter

# ── Stripe ───────────────────────────────────
# Dashboard: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Price IDs from your Stripe Products
# Create 2 products: "DevLore Pro" ($9/mo) and "DevLore Legend" ($19/mo)
STRIPE_PRO_PRICE_ID=price_
STRIPE_LEGEND_PRICE_ID=price_

# ── Email (optional — Chronicle emails) ──────
# Get key at: https://resend.com/
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=chronicles@devlore.app

# ── Inngest (background jobs) ─────────────────
# Sign up at: https://inngest.com/
# In dev mode these are auto-generated; set for production
INNGEST_SIGNING_KEY=signkey-prod-
INNGEST_EVENT_KEY=
