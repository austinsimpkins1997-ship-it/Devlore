// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth.js v5 Required Models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Core Application Models ────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // GitHub identity
  githubId     String?  @unique
  username     String?  @unique
  displayName  String  @default("")
  avatarUrl    String?
  bio          String?

  // Hero identity
  heroClass     String? // e.g. "Arcane Architect"
  heroTitle     String? // e.g. "Master of TypeScript Sorcery"
  heroClassSlug String? // e.g. "arcane-architect"
  originStory   String? @db.Text
  level         Int     @default(1)
  xp            Int     @default(0)

  // GitHub stats cache
  totalCommits         Int      @default(0)
  currentStreak        Int      @default(0)
  longestStreak        Int      @default(0)
  topLanguages         Json?    // { "TypeScript": 45, "Python": 30 }
  languageCount        Int      @default(0)
  firstCommitDate      DateTime?
  nightCommitRatio     Float    @default(0)
  docCommitRatio       Float    @default(0)
  avgRepoSize          Float    @default(0)
  hasInfraRepos        Boolean  @default(false)
  openSourceContribCount Int    @default(0)

  // Subscription
  tier             Tier    @default(FREE)
  stripeCustomerId String? @unique
  stripeSubId      String? @unique
  stripePriceId    String?
  trialEndsAt      DateTime?
  subCurrentPeriodEnd DateTime?

  // GitHub App installation (for private repos)
  ghInstallationId Int?

  // Character appearance (chosen at sign-up in the character creator)
  charBody      String  @default("neutral")
  charSkin      String  @default("umber")
  charHair      String  @default("raven")
  charCloak     String  @default("wanderer")
  charAura      String  @default("none")
  charCreated   Boolean @default(false)

  // Settings
  isPublic         Boolean @default(true)
  emailChronicle   Boolean @default(true)
  webhookToken     String? @unique // HMAC-SHA256 token for GitHub Action webhook auth

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastAnalyzedAt DateTime?

  // Relations
  accounts      Account[]
  sessions      Session[]
  chapters      Chapter[]
  loreCards     LoreCard[]
  analyses      Analysis[]
  forgeEntries  ForgeEntry[]
  questProgress QuestProgress[]
  trophies      Trophy[]
  kudosGiven    Kudos[]         @relation("KudosGiven")
  kudosReceived Kudos[]         @relation("KudosReceived")
  equipment     Equipment[]
  friendRequestsSent     Friendship[] @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[] @relation("FriendRequestsReceived")
  messagesSent     Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")

  @@index([username])
  @@index([tier])
}

model Chapter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  number  Int    // Chapter 1, 2, 3...
  title   String // "The Week the Dragon Was Slain"
  content String @db.Text
  summary String // 1-sentence hook

  weekStart DateTime
  weekEnd   DateTime

  // Raw stats
  commitCount Int      @default(0)
  prsMerged   Int      @default(0)
  bugsFixed   Int      @default(0)
  languages   Json?    // languages used this week
  newRepos    String[]

  xpEarned Int @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, number])
  @@index([userId, weekStart])
}

model LoreCard {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardType   CardType
  rarity     Rarity   @default(COMMON)
  name       String   // "Dragon Slayer"
  flavorText String   // Short narrative description
  milestone  String   // "100 commits reached"
  xpValue    Int      @default(0)

  unlockedAt DateTime @default(now())

  @@index([userId, rarity])
}

model Analysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       AnalysisStatus @default(PENDING)
  triggeredBy  String         // "first_login" | "webhook_push" | "manual" | "weekly_cron"
  inngestRunId String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?

  @@index([userId, status])
}

model ForgeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category  String // "code" | "design" | "learning" | "body" | "creative" | "other"
  text      String @db.Text
  narrative String @db.Text
  wordCount Int    @default(0)
  xpEarned  Int    @default(0)

  createdAt DateTime @default(now())

  trophies Trophy[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

model QuestProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questSlug String
  // Period the progress belongs to: "2026-08-14" (daily), "2026-W33" (weekly),
  // or "all-time" (milestone quests)
  periodKey String

  progress    Int       @default(0)
  target      Int       @default(1)
  completedAt DateTime?
  claimedAt   DateTime?
  xpAwarded   Int       @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, questSlug, periodKey])
  @@index([userId, periodKey])
}

model Trophy {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind        TrophyKind
  weekKey     String // ISO week, e.g. "2026-W33"
  title       String
  description String

  forgeEntryId String?
  forgeEntry   ForgeEntry? @relation(fields: [forgeEntryId], references: [id], onDelete: SetNull)

  awardedAt DateTime @default(now())

  // One trophy of each kind per week, platform-wide — makes weekly awards
  // idempotent even if the cron fires twice.
  @@unique([kind, weekKey])
  @@index([userId])
  @@index([awardedAt])
}

model Kudos {
  id         String @id @default(cuid())
  fromUserId String
  toUserId   String
  from       User   @relation("KudosGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User   @relation("KudosReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model Equipment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slot       EquipmentSlot
  rarity     EquipmentRarity
  name       String
  flavorText String
  power      Int             @default(0)

  // The level whose attainment dropped this item — one drop per level,
  // which also makes re-runs idempotent.
  levelAwarded Int
  awardedAt    DateTime @default(now())

  // Only one item may be equipped per slot (enforced in the equip API).
  equipped Boolean @default(false)

  @@unique([userId, levelAwarded])
  @@index([userId, rarity])
}

model Friendship {
  id          String @id @default(cuid())
  requesterId String
  addresseeId String
  requester   User   @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User   @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Message {
  id          String @id @default(cuid())
  senderId    String
  recipientId String
  sender      User   @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User   @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  body      String    @db.Text
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Tier {
  FREE
  PRO
  LEGEND
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum CardType {
  ACHIEVEMENT
  STREAK
  LANGUAGE
  PROJECT
  COLLABORATION
  CLASS_EVOLUTION
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

enum TrophyKind {
  BEST_SUBMISSION
  MOST_XP
  LONGEST_STREAK
}

enum EquipmentSlot {
  WEAPON
  ARMOR
  HELM
  RELIC
}

enum EquipmentRarity {
  RARE
  EPIC
  UNIQUE
  LEGENDARY
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}
